# Copy to .env and edit. Never commit the real .env.

# Port the server listens on
PORT=8080

# Where the SQLite database file lives
DATABASE_PATH=./data/fleetwatch.db

# Secret used to sign admin login tokens (JWTs).
# Generate a long random value, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# How long an admin stays logged in
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API from a browser
# (your dashboard's address). Use * only for local testing.
CORS_ORIGIN=*
